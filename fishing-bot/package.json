{
  "name": "fishing-bot",
  "version": "1.0.0",
  "description": "Bot automatizado para Fogo Fishing - executa casts de pesca automaticamente",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "single": "bun run src/single-bot.ts",
    "web": "bun run src/web/server.ts",
    "web:dev": "bun --watch src/web/server.ts",
    "test:cast": "bun run test-cast-result.ts",
    "test:proxy": "bun run test-proxy.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/static": "^1.4.7",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@types/ejs": "^3.1.5",
    "bn.js": "^5.2.2",
    "ejs": "^3.1.10",
    "elysia": "^1.4.21",
    "https-proxy-agent": "^7.0.6",
    "kire-workspace": "github:drysius/kire",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "socks-proxy-agent": "^8.0.5"
  }
}
