  "description": "Bot automatizado para Fogo Fishing - executa casts de pesca automaticamente",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
